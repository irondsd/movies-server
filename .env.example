# Bind to your Mac's LAN IPv4 address to make Movies available to your TV.
# Keep 127.0.0.1 for access from this Mac only.
BIND_IP=127.0.0.1
PORT=8765
# Defaults to $HOME/Movies. An absolute path can be set here:
# MOVIES_DIR=/absolute/path/to/Movies
# Match the folder owner's IDs: id -u; id -g
MOVIES_UID=501
MOVIES_GID=20
